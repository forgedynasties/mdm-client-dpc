<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingLeanbackLauncher">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Hardware serial (Build.getSerial) so devices identify by the label serial like the
         in-house fleet; the Device Owner self-grants this at service start -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Location telemetry (runtime grants are self-issued via Device Owner policy
         when the server enables location reporting; nothing is collected otherwise) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Lost-device Bluetooth (BleBeacon / BleListener): the legacy pair up to Android 11, the
         runtime trio from 12 on. BLUETOOTH_SCAN deliberately has no neverForLocation: that flag
         makes Android drop beacon advertisements from scan results. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Lifecycle -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets the wake activity take the keyguard down on a device with no secure lock —
         every kiosk and menu board. With a PIN set, the system prompts instead. -->
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service (checkin loop = dataSync; screen capture = mediaProjection, Phase 3) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- App inventory for telemetry (Android 11+ needs this to enumerate other packages) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Development permissions a Device Owner cannot self-grant but `adb shell pm grant`
         can (tools/enroll-adb.sh does, at enrollment). Without them the agent degrades:
         READ_LOGS (+ GET_USAGE_STATS appop) = DropBox crash/ANR reports and whole-device
         logcat; WRITE_SECURE_SETTINGS = keep our accessibility (remote input) service on. -->
    <uses-permission android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Also runs on Android TV boxes / dongles: no touchscreen, remote-driven -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name=".AgentApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MdmAgent"
        android:usesCleartextTraffic="true">

        <!-- Onboarding / status screen -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lab devices: pick this device's group (G3, 3 Nov 2026) -->
        <activity
            android:name=".ui.GroupPickActivity"
            android:exported="false"
            android:theme="@style/Theme.MdmAgent" />

        <!-- Managed provisioning (QR / zero-touch) on Android 12+: the setup wizard asks
             the DPC for its provisioning mode, then hands over for policy compliance
             once it is Device Owner. Both return at once; there is no on-device UI. -->
        <activity
            android:name=".provisioning.ProvisioningModeActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".provisioning.PolicyComplianceActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Wake: a transparent activity that exists for ~400ms with setTurnScreenOn, which
             is how an app without the system UID turns a display on (see ScreenControl). -->
        <activity
            android:name=".ui.WakeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:stateNotNeeded="true"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- App-lock host: becomes Home + pins (startLockTask) while the lock is active.
             Disabled by default so it's not a Home candidate until KioskManager enables it. -->
        <activity
            android:name=".kiosk.KioskHostActivity"
            android:enabled="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Staff PIN pad (0.10.0): opened by holding the top-left corner 5 s (or the D-pad
             code on a TV box) while the device is locked. Not exported: only the agent opens it. -->
        <activity
            android:name=".kiosk.StaffPinActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Lost mode: becomes Home + pins itself (startLockTask) while the device is lost.
             Disabled by default so it is never a Home candidate until LostMode enables it.
             Its own task, so showing it never has to clear the pinned kiosk task under it. -->
        <activity
            android:name=".lost.LostActivity"
            android:enabled="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="aio.app.mdmclient.dpc.lost"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Kiosk browser: WebView with a URL allowlist, hosted inside the pinned lock task -->
        <activity
            android:name=".kiosk.KioskBrowserActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Device Owner / Device Admin. DO component name used by adb:
             adb shell dpm set-device-owner aio.app.mdmclient.dpc/.MdmDeviceAdminReceiver -->
        <receiver
            android:name=".MdmDeviceAdminReceiver"
            android:description="@string/admin_description"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- The last step of an AIO Enroll setup: debugging off, then a restart. Only a sender
             holding WRITE_SECURE_SETTINGS (adb shell, system) may send it. -->
        <receiver
            android:name=".FinishSetupReceiver"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="aio.app.mdmclient.dpc.FINISH_SETUP" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".MdmService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Remote screen: one-time MediaProjection consent trampoline + capture service -->
        <activity
            android:name=".capture.ScreenCaptureConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".capture.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Remote input via accessibility gestures (user-enabled) -->
        <service
            android:name=".input.MdmAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
